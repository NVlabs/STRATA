# Historical Perlmutter image (NGC PyTorch 25.04). screamcast:0.2 cannot run
# the STRATA v1 branch. Build docker/Dockerfile with CUDA_ARCH=8.0 instead.

# Use NGC PyTorch image (requires nvcr.io access)
FROM nvcr.io/nvidia/pytorch:25.04-py3

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System dependencies for building wheels and cartopy (GEOS/PROJ)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    pkg-config \
    libgeos-dev \
    libproj-dev \
    proj-bin \
    proj-data \
    libhdf5-dev \
    libnetcdf-dev \
    libcurl4-openssl-dev \
    ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# Core Python tooling
RUN python3 -m pip install -U pip setuptools wheel

# Install Python requirements
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --prefer-binary \
    -f https://whl.natten.org \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    -r /tmp/requirements.txt

# Install earth2grid separately with special flags
RUN python3 -m pip install --no-cache-dir --prefer-binary --no-deps --no-build-isolation \
    https://github.com/NVlabs/earth2grid/archive/3415382a37e414a867d4c6ae2519e3e8afdbece1.tar.gz

ENV PIP_CONSTRAINT=""
RUN python3 -m pip install --upgrade "zarr>=3"

WORKDIR /workspace